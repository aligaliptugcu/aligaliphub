{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.zip",
      "*.log",
      "check_js.js",
      "note.txt"
    ],
    "rewrites": [
      {
        "source": "/retro-clock",
        "destination": "/retro-clock.html"
      },
      {
        "source": "/3darm",
        "destination": "/3darm.html"
      },
      {
        "source": "/**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 8080,
      "host": "127.0.0.1"
    }
  }
}
